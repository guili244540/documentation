{
  "schemaVersion": 2,
  "kind": "app",
  "name": "update-github-log",
  "modules": [
    {
      "type": "app",
      "name": "worker",
      "path": "apps/worker",
      "routes": [],
      "port": null,
      "serve": "worker",
      "runtime": "python",
      "build": {
        "context": ".",
        "dockerfile": "deploy/docker/Dockerfile.worker"
      },
      "platform": "workflows",
      "dev": {
        "startCommand": "bash ../../tools/uv.sh run --all-packages python -m worker.entrypoints.dev"
      }
    },
    {
      "type": "app",
      "name": "api",
      "path": "apps/api",
      "routes": [
        {
          "path": "/download"
        }
      ],
      "port": 3000,
      "serve": "server",
      "runtime": "python",
      "build": {
        "context": ".",
        "dockerfile": "deploy/docker/Dockerfile.api"
      },
      "dev": {
        "startCommand": "bash ../../tools/uv.sh run --all-packages python -m api.dev"
      }
    }
  ]
}
